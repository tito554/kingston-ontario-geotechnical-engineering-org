</script><div style="margin-top:.5rem;font-size:.78rem;color:#888;text-align:center">View larger map</div></div></section><footer style="background:#0F172A;color:rgba(255,255,255,.85);padding:3rem 1.5rem 1.5rem"><div style="max-width:720px;margin:0 auto;text-align:center"><h4 style="color:#FFF;font-size:1.15rem;margin:0 0 .3rem">Technical updates</h4><p style="margin:0 0 1.2rem;color:rgba(255,255,255,.65);font-size:.95rem">Get email updates</p><a href="mailto:info@geotechnical-engineering.org" style="display:inline-block;background:#10B981;color:#FFF;padding:.75rem 1.7rem;border-radius:6px;text-decoration:none;font-weight:700;font-size:.95rem">Subscribe — info@geotechnical-engineering.org</a><p style="margin:1.5rem 0 0;font-size:.82rem;color:rgba(255,255,255,.5)">Kingston Ontario, Canada · © 2026</p></div><div data-authority-refs class="authority-refs" style="text-align:center;font-size:.8rem;padding:.5rem 0;opacity:.6"><strong>References:</strong>CSA Group Standards · ASTM Standards · ISO Geotechnical</div><div class="updated-info" data-updated="2026-05-08" style="text-align:center;font-size:.85rem;opacity:.7;padding:.5rem 0">Last updated: 2026-05-08</div></footer><script id="sidebar-toggle-v3">
(function(){
if(window.__sidebarToggleV3){return}window.__sidebarToggleV3=true;
// Event delegation en document — funciona aunque DOMContentLoaded ya haya pasado.
// Ver REGLA 34 #7 (JS race conditions) y avance53.
document.addEventListener('click',function(e){
var btn=e.target.closest&&e.target.closest('.cat-toggle');
if(!btn)return;
e.preventDefault();
var item=btn.closest('.cat-item');
if(!item)return;
var sub=item.querySelector('.cat-sub');
var open=btn.getAttribute('aria-expanded')==='true';
btn.setAttribute('aria-expanded',open?'false':'true');
if(sub){if(open){sub.setAttribute('hidden','')}else{sub.removeAttribute('hidden')}}
});
})();
</script></body></html>